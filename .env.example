# Copy to .env for local development. Never commit .env.
GOOGLE_CLOUD_PROJECT=fs-dev
REGION=asia-south1
RAW_BUCKET=fs-dev-raw
CLEAN_BUCKET=fs-dev-clean

# Local emulators (firebase emulators:start / gcloud beta emulators pubsub start)
FIRESTORE_EMULATOR_HOST=localhost:8081
PUBSUB_EMULATOR_HOST=localhost:8085

# AI Studio key for development only; production uses Vertex AI with the service account.
GEMINI_API_KEY=

# Model IDs live in config, not code (see prompts/models.json)

# Web dashboard. The sidebar's Data: Demo / Live switch picks the data per browser.
# DATA_BACKEND=firestore   # make Live the default
# DATA_MODE_LOCKED=1        # production: hide the switch, keep DATA_BACKEND's mode
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=fs-dev.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=fs-dev
INGEST_URL=http://localhost:8098
API_URL=http://localhost:8097
# Same value as the API's INTERNAL_TOKEN (Secret Manager: internal-token)
INTERNAL_TOKEN=

# Worker: production uses Vertex AI with the service account
# GOOGLE_GENAI_USE_VERTEXAI=true
# GOOGLE_CLOUD_LOCATION=asia-south1
# Gemma is served by the Gemini API; on Vertex set this, otherwise dedup/safety use Flash
GEMMA_API_KEY=
# Override model IDs from prompts/models.json if needed
# MODEL_PRO= MODEL_FLASH= MODEL_EMBEDDING= MODEL_GEMMA=
