# One image recipe for the TypeScript services (ingest, api, mcp). Build from the repo root:
#   docker build -f services/Dockerfile.node --build-arg SERVICE=api -t api .
# The whole repo is copied (see .dockerignore) so package-lock.json matches every workspace.
FROM node:22-slim AS build
ARG SERVICE
WORKDIR /repo
COPY . .
RUN npm ci --include-workspace-root -w packages/shared -w services/${SERVICE}
RUN npm run build -w packages/shared && npm run build -w services/${SERVICE}
RUN npm prune --omit=dev

FROM node:22-slim
ARG SERVICE
ENV NODE_ENV=production PORT=8080
WORKDIR /repo
COPY --from=build /repo/package.json ./package.json
COPY --from=build /repo/node_modules ./node_modules
COPY --from=build /repo/packages/shared ./packages/shared
COPY --from=build /repo/services/${SERVICE} ./services/${SERVICE}
WORKDIR /repo/services/${SERVICE}
USER node
CMD ["node", "dist/server.js"]
