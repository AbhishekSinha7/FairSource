rules_version = '2';
// The dashboards read and write only through the Next.js server (Admin SDK,
// which bypasses these rules) after checking the session's role and orgId.
// No client reads or writes Firestore directly.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
